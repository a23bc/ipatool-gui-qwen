{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/main", "src/preload", "src/shared", "scripts", "vite.config.ts", "tests"],
  // `tests/dom` exercises renderer stores and components, which are only valid
  // against the DOM libs in tsconfig.json - checking them here would demand node
  // types they deliberately do not have. That project includes them instead.
  "exclude": ["tests/dom"]
}
